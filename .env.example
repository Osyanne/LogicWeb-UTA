# Clave secreta de Django (genera una NUEVA y larga para producción)
DJANGO_SECRET_KEY=tu-clave-secreta-aqui

# Modo debug. Local: True (por defecto). En producción (Render): False
DJANGO_DEBUG=True

# Base de datos. En local se ignora (usa SQLite). En Render con PostgreSQL
# esta variable la provee el servicio automáticamente:
# DATABASE_URL=postgres://usuario:clave@host:5432/nombre_db
